{
  "id": "/",
  "name": "منصة الشجاع للتوصيل السريع",
  "short_name": "الشجاع",
  "description": "منصة إدارة وتتبع شحنات التوصيل السريع",
  "start_url": "/?source=pwa",
  "scope": "/",
  "scope_extensions": [
    { "origin": "https://shujja-delivery.mhymnslah523.workers.dev" }
  ],
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#facc15",
  "lang": "ar",
  "dir": "rtl",
  "categories": ["business", "logistics", "productivity"],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ec4e53b7",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "id": "com.shujja.delivery",
      "url": "https://play.google.com/store/apps/details?id=com.shujja.delivery"
    }
  ],
  "file_handlers": [
    {
      "action": "/?action=open-file",
      "name": "ملفات قوائم الشحنات",
      "accept": {
        "text/csv": [".csv"],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+shujja",
      "url": "/?track=%s"
    }
  ],
  "share_target": {
    "action": "/?action=share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "launch_handler": {
    "client_mode": "auto"
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "note_taking": {
    "new_note_url": "/?action=new-note"
  },
  "widgets": [
    {
      "name": "حالة الشحنات",
      "description": "متابعة سريعة للشحنات النشطة",
      "tag": "shujja-summary",
      "template": "widget-template",
      "ms_ac_template": "widget.json",
      "data": "widget-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshot.png",
          "sizes": "540x720",
          "label": "ملخص الشحنات"
        }
      ],
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot.png",
      "sizes": "540x720",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "واجهة الهاتف"
    },
    {
      "src": "/screenshot-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "واجهة سطح المكتب"
    }
  ],
  "shortcuts": [
    {
      "name": "لوحة التحكم",
      "url": "/",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
